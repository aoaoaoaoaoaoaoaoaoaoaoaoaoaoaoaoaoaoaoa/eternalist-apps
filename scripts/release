#!/bin/sh
set -eu

die() {
    printf 'release refused: %s\n' "$1" >&2
    exit 1
}

version=${1:-}
mode=${2:-check}
[ -n "$version" ] || die 'usage: scripts/release VERSION [check|publish]'
case "$version" in
    *[!0-9.]*|'') die "invalid version: $version" ;;
esac
case "$mode" in
    check|publish) ;;
    *) die "invalid mode: $mode" ;;
esac

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

[ -z "$(git status --porcelain)" ] || die 'worktree is dirty'
grep -Eq '^\[patch\.' Cargo.toml && die 'Cargo.toml carries a [patch] section; release from registry dependencies only'
repository=$(pwd -P)
git ls-files -- Cargo.toml '*/Cargo.toml' | while IFS= read -r manifest; do
    sed -n 's/.*path[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | while IFS= read -r dependency; do
        candidate=$(dirname "$manifest")/$dependency
        if [ -f "$candidate" ]; then
            continue
        fi
        target=$(cd "$candidate" 2>/dev/null && pwd -P) || exit 1
        case $target in
            "$repository" | "$repository"/*) ;;
            *) exit 1 ;;
        esac
    done || exit 1
done || die 'a manifest depends on a path outside the repository; release from registry dependencies only'
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] ||
    die 'HEAD is not the pushed origin/main commit'
grep -Fqx "version = \"$version\"" Cargo.toml ||
    die "Cargo.toml does not declare package version $version"
git tag --points-at HEAD | grep -Fqx "v$version" ||
    die "v$version does not tag HEAD"
git tag -v "v$version" >/dev/null 2>&1 || die "v$version is not a valid signed tag"

scripts/check
scripts/audit
command -v cargo-semver-checks >/dev/null 2>&1 ||
    die 'cargo-semver-checks is required: cargo install cargo-semver-checks --version 0.50.0 --locked'
cargo semver-checks
cargo package --locked

if [ "$mode" = publish ]; then
    cargo publish --locked
else
    printf 'release candidate v%s is clean and packaged; publication was not requested\n' "$version"
fi
