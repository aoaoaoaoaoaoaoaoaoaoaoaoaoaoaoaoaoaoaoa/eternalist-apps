#!/bin/sh
set -eu

usage() {
    printf 'usage: scripts/web-atelier [build|check|serve [PORT]|serve-built [PORT]]\n' >&2
}

action=${1:-serve}
case "$action" in
    build|check) [ "$#" -eq 1 ] || { usage; exit 2; } ;;
    serve|serve-built) [ "$#" -le 2 ] || { usage; exit 2; } ;;
    *) usage; exit 2 ;;
esac

case "$action" in
    serve|serve-built)
        port=${2:-${PORT:-4174}}
        case "$port" in
            ''|*[!0-9]*) printf 'invalid port: %s\n' "$port" >&2; exit 2 ;;
        esac
        if [ "$port" -gt 65535 ] || { [ "$action" = serve-built ] && [ "$port" -eq 0 ]; }; then
            printf 'invalid port: %s\n' "$port" >&2
            exit 2
        fi
        ;;
esac

target=$(cargo metadata --format-version 1 --no-deps | jq -r .target_directory)
out="$target/web-atelier"
wasm="$target/wasm32-unknown-unknown/release/examples/atelier.wasm"

verify_bundle() {
    bundle=$1
    test -s "$bundle/index.html"
    test -s "$bundle/atelier.svg"
    test -s "$bundle/eternalist.js"
    test -s "$bundle/eternalist_bg.wasm"
    rg -q --fixed-strings 'href="./atelier.svg"' "$bundle/index.html"
    rg -q --fixed-strings 'import init from "./eternalist.js"' "$bundle/index.html"
    rg -q --fixed-strings 'await navigator.gpu.requestAdapter({' "$bundle/index.html"
    rg -q --fixed-strings 'data-eternalist="booting"' "$bundle/index.html"
    rg -q --fixed-strings 'wasm.__wbindgen_start();' "$bundle/eternalist.js"
}

if [ "$action" != serve-built ]; then
    if [ "$action" = check ]; then
        cargo clippy \
            --target wasm32-unknown-unknown \
            --example atelier \
            --locked \
            -- \
            -D warnings
    fi
    cargo build --release --target wasm32-unknown-unknown --example atelier

    stage=$(mktemp -d "$target/.web-atelier.XXXXXXXX")
    previous="$target/.web-atelier.previous"
    cleanup() {
        rm -rf "$stage"
        if [ ! -e "$out" ] && [ -e "$previous" ]; then
            mv "$previous" "$out"
        fi
    }
    trap cleanup EXIT HUP INT TERM

    wasm-bindgen \
        --target web \
        --no-typescript \
        --remove-name-section \
        --remove-producers-section \
        --out-dir "$stage" \
        --out-name eternalist \
        "$wasm"
    install -Dm644 web/atelier.html "$stage/index.html"
    install -Dm644 web/atelier.svg "$stage/atelier.svg"
    verify_bundle "$stage"

    rm -rf "$previous"
    if [ -e "$out" ]; then
        mv "$out" "$previous"
    fi
    mv "$stage" "$out"
    rm -rf "$previous"
    trap - EXIT HUP INT TERM
else
    if [ ! -d "$out" ]; then
        printf 'no built atelier at %s; run scripts/web-atelier build first\n' "$out" >&2
        exit 1
    fi
    verify_bundle "$out"
fi

printf 'Eternalist WebGPU atelier: %s\n' "$out"

case "$action" in
    serve|serve-built)
        if [ "$action" = serve-built ]; then
            bind_policy=fixed
        else
            bind_policy=elastic
        fi
        exec python3 - "$out" "$port" "$bind_policy" <<'PY'
import errno
import os
import socket
import sys
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

root, raw_port, bind_policy = sys.argv[1:]
host = "127.0.0.1"
requested = int(raw_port)


class AtelierHandler(SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()


handler = partial(AtelierHandler, directory=root)


def notify_ready(url):
    address = os.environ.get("NOTIFY_SOCKET")
    if not address:
        return
    if address.startswith("@"):
        address = "\0" + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notifier:
        notifier.connect(address)
        notifier.sendall(f"READY=1\nSTATUS=Serving {url}".encode())


try:
    server = ThreadingHTTPServer((host, requested), handler)
except OSError as error:
    if error.errno != errno.EADDRINUSE:
        raise
    if bind_policy == "fixed":
        print(f"Fixed atelier port {requested} is occupied.", file=sys.stderr, flush=True)
        raise SystemExit(98) from None
    server = ThreadingHTTPServer((host, 0), handler)
    print(
        f"Port {requested} is occupied; selected {server.server_address[1]}.",
        flush=True,
    )

url = f"http://{host}:{server.server_address[1]}"
notify_ready(url)
print(f"Serving {url}", flush=True)
try:
    server.serve_forever()
except KeyboardInterrupt:
    pass
finally:
    server.server_close()
PY
        ;;
esac
