#!/usr/bin/env bash
set -euo pipefail

command -v cargo-audit >/dev/null || {
  printf 'cargo-audit is required\n' >&2
  exit 1
}
# ttf-parser 0.25 arrives only through Brass's glyph-audit feature, a dev
# dependency for the typeface gate; it never ships in a product binary.
# RUSTSEC-2026-0192 is maintenance status, not a vulnerability.
cargo audit --deny warnings --ignore RUSTSEC-2026-0192
